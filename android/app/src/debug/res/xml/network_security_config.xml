<?xml version="1.0" encoding="utf-8"?>
<!-- Solo debug: anche http, per l'API locale (es. http://10.0.2.2:5080/api dall'emulatore o
     l'IP del PC in LAN). La release (src/main) ammette solo HTTPS. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
